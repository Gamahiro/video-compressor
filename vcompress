#!/usr/bin/env python3
"""Compress a video with ffmpeg so it fits in chat apps like Discord."""

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

LIMIT_MB = 20

# name: (x264 crf, max height, audio bitrate). Higher crf = smaller file.
PRESETS = {
    "low": (33, 480, "64k"),
    "med": (28, 720, "96k"),
    "high": (24, 1080, "128k"),
}


def main():
    p = argparse.ArgumentParser(description="Compress a video with ffmpeg.")
    p.add_argument("input", type=Path, help="video file to compress")
    p.add_argument("-o", "--output", type=Path, help="output path (default: <name>_<level>.mp4)")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--low", dest="level", action="store_const", const="low", help="smallest file, 480p")
    g.add_argument("--med", dest="level", action="store_const", const="med", help="balanced, 720p (default)")
    g.add_argument("--high", dest="level", action="store_const", const="high", help="best quality, 1080p")
    args = p.parse_args()

    level = args.level or "med"
    crf, height, audio = PRESETS[level]

    if not shutil.which("ffmpeg"):
        sys.exit("error: ffmpeg not found in PATH")
    if not args.input.is_file():
        sys.exit(f"error: no such file: {args.input}")

    out = args.output or args.input.with_name(f"{args.input.stem}_{level}.mp4")
    if out.resolve() == args.input.resolve():
        sys.exit("error: output would overwrite input")

    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-stats", "-y",
        "-i", str(args.input),
        # Downscale only if taller than the target; keep width even.
        "-vf", f"scale=-2:'min({height},ih)'",
        "-c:v", "libx264", "-preset", "slow", "-crf", str(crf), "-pix_fmt", "yuv420p",
        "-c:a", "aac", "-b:a", audio,
        "-movflags", "+faststart",
        str(out),
    ]
    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError:
        out.unlink(missing_ok=True)
        sys.exit("error: ffmpeg failed")
    except KeyboardInterrupt:
        out.unlink(missing_ok=True)
        sys.exit("\ncancelled")

    before = args.input.stat().st_size / 1e6
    after = out.stat().st_size / 1e6
    print(f"\n{args.input.name}: {before:.1f} MB -> {out.name}: {after:.1f} MB")
    if after > LIMIT_MB:
        hint = "--low" if level != "low" else "a shorter clip"
        print(f"warning: still over {LIMIT_MB} MB; try {hint}")


if __name__ == "__main__":
    main()
